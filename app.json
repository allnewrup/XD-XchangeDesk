{
  "expo": {
    "name": "Xchange Desk",
    "slug": "xchange-desk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xchangedesk.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.xchangedesk.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1b232b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Xchange Desk uses your location to sort exchange houses and banks by distance and to show where you are on the map. It stays on your phone."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#1b232b",
          "imageWidth": 220
        }
      ],
      "expo-font"
    ],
    "scheme": "xchangedesk",
    "description": "Compare estimated exchange rates across UAE exchange houses and banks."
  }
}
